{
  "name": "Sweet Help",
  "short_name": "Sweet Help",
  "description": "Sweet Help: postres, tienda, juegos y presentador.",
  "id": "./",
  "start_url": "./index5.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f2dc",
  "theme_color": "#bd5c73",
  "lang": "es",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./miprez.html",
      "accept": {
        "application/x-sweethelp-presentacion": [
          ".sh"
        ]
      },
      "icons": [
        {
          "src": "filetype-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}